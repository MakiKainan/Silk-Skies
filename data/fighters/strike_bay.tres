[resource]
script = ExtResource("1_item")
id = &"strike_bay"
display_name = "Strike Bay"
description = "Launches two bombers that make diving runs at the enemy and release a homing warhead at close range. Explosive: brutal on bare hull."
roll_pool = ExtResource("3_pool")
base_mods = Array[ExtResource("2_mod")]([])
