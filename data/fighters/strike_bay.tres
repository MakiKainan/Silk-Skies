fighter_count = 2
fighter_hull = 30.0
fighter_damage = 40.0
fighter_lifetime = 10.0
launch_cooldown = 18.0
role = "Dives at the enemy hull"
role_kind = 1
projectile = ExtResource("4_proj")
fighter_speed = 22.0
fighter_turn_deg = 200.0
fire_cooldown = 2.8
attack_range = 10.0
