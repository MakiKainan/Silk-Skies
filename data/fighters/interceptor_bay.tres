[resource]
script = ExtResource("1_item")
id = &"interceptor_bay"
display_name = "Interceptor Bay"
description = "Launches two escorts that circle your ship, shoot down incoming missiles, and pick off enemy fighters. Between missiles they plink at the enemy ship."
roll_pool = ExtResource("3_pool")
base_mods = Array[ExtResource("2_mod")]([])
fighter_name = "Interceptor"
fighter_count = 2
fighter_hull = 15.0
fighter_damage = 6.0
fighter_lifetime = 14.0
launch_cooldown = 14.0
role = "Shoots down incoming missiles"
role_kind = 0
projectile = ExtResource("4_proj")
fighter_speed = 26.0
fighter_turn_deg = 300.0
fire_cooldown = 0.45
attack_range = 18.0
