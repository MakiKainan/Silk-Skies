[resource]
script = ExtResource("1_item")
id = &"interceptor_bay"
display_name = "Interceptor Bay"
description = "Launches fighters that shoot down incoming missiles. (Fighters are not yet active in combat.)"
roll_pool = ExtResource("3_pool")
base_mods = Array[ExtResource("2_mod")]([])
fighter_name = "Interceptor"
fighter_count = 2
fighter_hull = 15.0
fighter_damage = 3.0
fighter_lifetime = 14.0
launch_cooldown = 14.0
role = "Shoots down incoming missiles"
