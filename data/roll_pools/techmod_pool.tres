max_value = 25

[sub_resource type="Resource" id="T2"]
script = ExtResource("2_tpl")
stat = &"shield_regen"
op = 0
scope = 2
min_value = 1
max_value = 3

[sub_resource type="Resource" id="T3"]
script = ExtResource("2_tpl")
stat = &"armor"
op = 0
scope = 2
min_value = 1
max_value = 2

[sub_resource type="Resource" id="T4"]
script = ExtResource("2_tpl")
stat = &"max_hull"
op = 0
scope = 2
min_value = 15
max_value = 40

[resource]
script = ExtResource("1_pool")
id = &"techmod_pool"
templates = Array[ExtResource("2_tpl")]([SubResource("T1"), SubResource("T2"), SubResource("T3"), SubResource("T4")])
