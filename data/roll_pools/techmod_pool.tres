[gd_resource type="Resource" script_class="RollPool" format=3]

[ext_resource type="Script" path="res://scripts/data/roll_pool.gd" id="1_pool"]
[ext_resource type="Script" path="res://scripts/data/roll_template.gd" id="2_tpl"]

[sub_resource type="Resource" id="T1"]
